# Copy to android/keystore.properties and fill in. That file is gitignored.
#
# Create the keystore first (see README / the keytool command), then point
# storeFile at it. A relative path resolves from the android/ directory; an
# absolute path lets you keep the keystore outside the repo entirely, which is
# the safer choice.
storeFile=lexdiary-release.jks
storePassword=CHANGE_ME
keyAlias=lexdiary
keyPassword=CHANGE_ME
